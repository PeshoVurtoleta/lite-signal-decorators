{
  "name": "@zakkster/lite-signal-decorators",
  "version": "1.1.1",
  "description": "Standard-decorators layer over @zakkster/lite-signal (TC39 decorators proposal, Stage 2.7 since 2026-05; TS 5.x / Babel 2023-11 emit unchanged). The reactive class layer where an instance has a measured cost, deterministic teardown, and a churn benchmark.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./SignalDecorators.js",
  "module": "./SignalDecorators.js",
  "types": "./SignalDecorators.d.ts",
  "exports": {
    ".": {
      "types": "./SignalDecorators.d.ts",
      "node": "./SignalDecorators.js",
      "import": "./SignalDecorators.js",
      "default": "./SignalDecorators.js"
    }
  },
  "sideEffects": false,
  "homepage": "https://github.com/PeshoVurtoleta/lite-signal-decorators#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-signal-decorators.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-signal-decorators/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "keywords": [
    "signal",
    "signals",
    "reactive",
    "reactivity",
    "decorators",
    "standard-decorators",
    "computed",
    "derived",
    "class",
    "view-model",
    "zero-gc",
    "zero-allocation",
    "dispose",
    "lifecycle",
    "lite-signal"
  ],
  "files": [
    "SignalDecorators.js",
    "SignalDecorators.d.ts",
    "llms.txt",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec 'test/*.test.mjs'",
    "test:gc": "node --expose-gc --test --test-reporter=spec 'test/*.test.mjs'",
    "fixtures": "node test/fixtures/regen.mjs",
    "torture": "node test/torture/run.mjs",
    "torture:semantic": "node test/torture/run.mjs --group semantic",
    "torture:soak": "node test/torture/run.mjs --group soak",
    "torture:controls": "node test/torture/run.mjs --controls",
    "torture:peer-preview": "node test/torture/peer-preview.mjs",
    "gate": "node test/gate.mjs",
    "cookbook": "node cookbook/run.mjs",
    "spikes": "for f in spikes/*.mjs; do echo \"== $f ==\"; node --expose-gc \"$f\" || exit 1; done",
    "spike:emit": "node --expose-gc spikes/emit/probe.mjs",
    "spike:ownership": "node --expose-gc spikes/ownership.mjs",
    "spike:storage": "node --expose-gc spikes/storage-bench.mjs",
    "spike:manual": "node --expose-gc spikes/manual-call.mjs",
    "spike:poison": "node --expose-gc spikes/poison.mjs",
    "spike:buildless": "node --expose-gc spikes/buildless.mjs",
    "fixtures:regen": "node spikes/emit/regen.mjs",
    "demo:build": "node demo/build.mjs",
    "demo:check": "node demo/build.mjs --check",
    "demo:gc": "node --expose-gc demo/gc-lane.mjs",
    "demo:storm": "node --expose-gc demo/storm-lane.mjs"
  },
  "peerDependencies": {
    "@zakkster/lite-signal": ">=1.5.0 <2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-decorators": "^7.25.0",
    "@babel/preset-typescript": "^7.29.7",
    "@zakkster/lite-arena": "1.9.0",
    "@zakkster/lite-await": "1.1.1",
    "@zakkster/lite-devtools": "^1.4.0",
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-signal": "1.5.0",
    "@zakkster/lite-store": "1.2.0",
    "@zakkster/lite-watch-ex": "^1.1.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  }
}
